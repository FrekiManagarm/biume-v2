# These will be automatically created by Neon Launchpad (https://neon.new).
# You will also need to 
DATABASE_URL=
DATABASE_URL_POOLER=
UPLOADTHING_TOKEN=

# Private Cloudflare R2 bucket holding mobile audio captures.
# The bucket must stay private: no public read, no listing, no durable URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_AUDIO_BUCKET=

# Comma-separated deep link origins trusted by Better Auth for the mobile app.
MOBILE_TRUSTED_ORIGINS=biume://
