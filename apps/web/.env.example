# Variables d'environnement de l'application web.
#
# `packages/env` les valide au chargement du module : une seule manquante fait
# échouer le démarrage avec « Invalid environment variables ». La liste
# ci-dessous est exhaustive — la tenir à jour avec `packages/env/src/server.ts`
# et `packages/env/src/web.ts`.

# --- Base de données ---------------------------------------------------------
# Créées automatiquement par Neon Launchpad (https://neon.new).
DATABASE_URL=
DATABASE_URL_POOLER=

# --- Authentification --------------------------------------------------------
# Secret de signature des sessions Better Auth. Générer avec :
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001
APP_URL=http://localhost:3001

# Connexion Google sur le web. Le mobile n'utilise pas de connexion sociale.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Chiffrement applicatif --------------------------------------------------
ENCRYPTION_KEY=

# --- Intelligence artificielle -----------------------------------------------
# Transcription des dictées (gpt-4o-transcribe) et extraction structurée.
OPENAI_API_KEY=

# --- Courriels ---------------------------------------------------------------
RESEND_API_KEY=

# --- Facturation -------------------------------------------------------------
AUTUMN_SECRET_KEY=

# --- Téléversement de documents ----------------------------------------------
UPLOADTHING_TOKEN=

# --- Stockage audio ----------------------------------------------------------
# Bucket Cloudflare R2 privé contenant les dictées mobiles.
# Il doit rester privé : aucune lecture publique, aucun listage, aucune URL
# durable. La seule URL jamais émise est celle du téléversement, signée et
# valable dix minutes.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_AUDIO_BUCKET=

# --- Mobile ------------------------------------------------------------------
# Origines de lien profond auxquelles Better Auth fait confiance, séparées par
# des virgules. Les jokers sont rejetés : chaque origine est déclarée.
MOBILE_TRUSTED_ORIGINS=biume://

# --- URL publique --------------------------------------------------------------
# Base des liens absolus envoyés dans les courriels (rappels de suivi,
# invitations d'essai). Préfixe NEXT_PUBLIC_ car aussi lue côté client
# (tableau des rapports). Ni validée ni déclarée par `packages/env` — à la
# différence des autres variables de ce fichier, une absence ne fait pas
# échouer le démarrage, elle produit un lien cassé.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# --- Environnement -----------------------------------------------------------
NODE_ENV=development

# Le paywall d'abonnement est neutralise en developpement. Mettre a "true"
# pour le rallumer et travailler dessus.
BILLING_GATE_IN_DEV=

# --- Analytique (client, préfixe VITE_) --------------------------------------
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Facultatif.
VITE_POSTHOG_FEEDBACK_SURVEY_ID=

# URL publique de la vidéo de présentation (UploadThing).
# Sans elle, la carte d'onboarding du dashboard reste simplement masquée.
NEXT_PUBLIC_ONBOARDING_VIDEO_URL=
